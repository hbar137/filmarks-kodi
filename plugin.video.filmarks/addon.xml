<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.filmarks"
       name="Filmarks"
       version="1.0.2"
       provider-name="hbar137">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <!-- Needed by the vendored Otaku scrapers (resources/lib/otaku_scrapers/). -->
        <import addon="script.module.beautifulsoup4"/>
        <!-- Optional: only improves HLS playback of embed sources, and
             views_shows.py falls back to Kodi's own demuxer without it.
             Required, it blocked installs where Kodi can't fetch it. -->
        <import addon="script.module.inputstreamhelper" optional="true"/>
        <!-- Otaku's control.py references context.otaku at import time for
             icon + info.db paths. We vendor it as a sibling addon in this
             same Kodi repo so it auto-installs alongside. -->
        <import addon="context.otaku"/>
    </requires>
    <extension point="xbmc.python.pluginsource"
               library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Filmarks — browse and play from your Filmarks server</summary>
        <description lang="en_GB">Connects Kodi to a Filmarks server. Browse dashboard, watchlist, shows, history, and search; play movies and episodes via Real-Debrid with subtitles and Trakt scrobbling.</description>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <source>https://github.com/hbar137/filmarks-kodi</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
